+package helps
+
+import (
+	"encoding/base64"
+	"encoding/binary"
+	"net/http"
+	"testing"
+)
+
+func TestManagedCodexStateCredentialModelAndExpiry(t *testing.T) {
+	const now int64 = 1800000000
+	raw := make([]byte, 217)
+	raw[0] = 128
+	binary.BigEndian.PutUint64(raw[1:9], uint64(now-10))
+	state := base64.URLEncoding.EncodeToString(raw)
+	good := ManagedCodexState{Enabled: true, UpdatedAt: now, Models: []string{"gpt-6-astra"}, Entries: map[string]ManagedCodexStateEntry{"auth-a\x00gpt-6-astra": {State: state, ExpiresAt: now + 3590}}}
+	for _, tc := range []struct {
+		name, auth, model  string
+		mutate             func(*ManagedCodexState)
+		wantErr, wantState bool
+	}{
+		{"matching", "auth-a", "gpt-6-astra", nil, false, true},
+		{"wrong credential", "auth-b", "gpt-6-astra", nil, true, false},
+		{"unmanaged model", "auth-a", "gpt-5.6-luna", nil, false, false},
+		{"disabled", "auth-a", "gpt-6-astra", func(c *ManagedCodexState) { c.Enabled = false }, false, false},
+		{"stale controller", "auth-a", "gpt-6-astra", func(c *ManagedCodexState) { c.UpdatedAt = now - 31 }, true, false},
+		{"expired", "auth-a", "gpt-6-astra", func(c *ManagedCodexState) {
+			c.Entries["auth-a\x00gpt-6-astra"] = ManagedCodexStateEntry{State: state, ExpiresAt: now}
+		}, true, false},
+		{"312 rejected", "auth-a", "gpt-6-astra", func(c *ManagedCodexState) {
+			b := make([]byte, 233)
+			copy(b, raw)
+			c.Entries["auth-a\x00gpt-6-astra"] = ManagedCodexStateEntry{State: base64.URLEncoding.EncodeToString(b), ExpiresAt: now + 3590}
+		}, true, false},
+		{"future token", "auth-a", "gpt-6-astra", func(c *ManagedCodexState) {
+			b := append([]byte(nil), raw...)
+			binary.BigEndian.PutUint64(b[1:9], uint64(now+30))
+			c.Entries["auth-a\x00gpt-6-astra"] = ManagedCodexStateEntry{State: base64.URLEncoding.EncodeToString(b), ExpiresAt: now + 3590}
+		}, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := good
+			c.Entries = map[string]ManagedCodexStateEntry{}
+			for k, v := range good.Entries {
+				c.Entries[k] = v
+			}
+			if tc.mutate != nil {
+				tc.mutate(&c)
+			}
+			h := http.Header{}
+			err := applyManagedCodexState(h, tc.auth, tc.model, c, now)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if (h.Get("X-Codex-Turn-State") != "") != tc.wantState {
+				t.Fatal("unexpected state injection")
+			}
+		})
+	}
+}
