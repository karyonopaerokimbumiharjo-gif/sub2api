+package helps
+
+import (
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"os"
+	"time"
+)
+
+var ErrManagedCodexState = errors.New("292 state unavailable for selected credential and model")
+
+type ManagedCodexState struct {
+	Enabled   bool                              `json:"enabled"`
+	UpdatedAt int64                             `json:"updated_at"`
+	Models    []string                          `json:"models"`
+	Entries   map[string]ManagedCodexStateEntry `json:"entries"`
+}
+type ManagedCodexStateEntry struct {
+	State     string `json:"state"`
+	ExpiresAt int64  `json:"expires_at"`
+}
+
+func ManagedCodexStateConfigured() bool { return os.Getenv("SUB2API_CODEX_STATE_FILE") != "" }
+
+// ApplyManagedCodexState reads an atomic, private snapshot written by the
+// credential-bound collector. Never reuse a state across credentials or models.
+func ApplyManagedCodexState(h http.Header, authIndex, model string) error {
+	path := os.Getenv("SUB2API_CODEX_STATE_FILE")
+	if path == "" {
+		return nil
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil || len(raw) > 1<<20 {
+		return ErrManagedCodexState
+	}
+	var cfg ManagedCodexState
+	if json.Unmarshal(raw, &cfg) != nil {
+		return ErrManagedCodexState
+	}
+	return applyManagedCodexState(h, authIndex, model, cfg, time.Now().Unix())
+}
+func applyManagedCodexState(h http.Header, authIndex, model string, cfg ManagedCodexState, now int64) error {
+	if cfg.UpdatedAt > now+5 || now-cfg.UpdatedAt > 30 {
+		return ErrManagedCodexState
+	}
+	if !cfg.Enabled {
+		return nil
+	}
+	gated := false
+	for _, m := range cfg.Models {
+		if m == model {
+			gated = true
+			break
+		}
+	}
+	if !gated {
+		return nil
+	}
+	h.Del("X-Codex-Turn-State")
+	entry, ok := cfg.Entries[authIndex+"\x00"+model]
+	if !ok || authIndex == "" || entry.ExpiresAt <= now || entry.ExpiresAt > now+3600 || len(entry.State) != 292 {
+		return ErrManagedCodexState
+	}
+	decoded, err := base64.URLEncoding.DecodeString(entry.State)
+	if err != nil || len(decoded) != 217 || decoded[0] != 128 {
+		return ErrManagedCodexState
+	}
+	issued := int64(binary.BigEndian.Uint64(decoded[1:9]))
+	if issued > now+5 || issued <= now-3600 || entry.ExpiresAt > issued+3600 {
+		return ErrManagedCodexState
+	}
+	h.Set("X-Codex-Turn-State", entry.State)
+	return nil
+}
