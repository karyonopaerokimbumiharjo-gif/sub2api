diff --git a/internal/runtime/executor/codex_executor_quota_scope_test.go b/internal/runtime/executor/codex_executor_quota_scope_test.go
new file mode 100644
index 0000000..6d006e2
--- /dev/null
+++ b/internal/runtime/executor/codex_executor_quota_scope_test.go
@@ -0,0 +1,107 @@
+package executor
+
+import (
+	"errors"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestCodexUsageLimitScopesIndependentSparkPool(t *testing.T) {
+	const quota = `{"type":"usage_limit_reached","message":"The usage limit has been reached","resets_in_seconds":3600}`
+	const body = `{"error":` + quota + `}`
+	for _, tc := range []struct {
+		name           string
+		headers        http.Header
+		modelCooling   bool
+		wantCredential bool
+	}{
+		{name: "explicit Spark pool", headers: http.Header{"X-Codex-Active-Limit": {"codex_bengalfox"}}},
+		{name: "Spark display name", headers: http.Header{"X-Codex-Active-Limit": {"GPT-5.3-Codex-Spark"}}},
+		{name: "case and whitespace", headers: http.Header{"X-Codex-Active-Limit": {" CODEX_BENGALFOX "}}},
+		{name: "main quota", headers: http.Header{"X-Codex-Active-Limit": {"premium"}}, wantCredential: true},
+		{name: "unknown quota", headers: http.Header{"X-Codex-Active-Limit": {"future_shared_limit"}}, wantCredential: true},
+		{name: "missing scope", wantCredential: true},
+		{name: "explicit model cooling with missing scope", modelCooling: true},
+		{name: "explicit model cooling with shared quota", modelCooling: true, headers: http.Header{"X-Codex-Active-Limit": {"premium"}}},
+		{name: "additional Spark data does not narrow main quota", headers: http.Header{
+			"X-Codex-Active-Limit":                     {"premium"},
+			"X-Codex-Bengalfox-Limit-Name":             {"GPT-5.3-Codex-Spark"},
+			"X-Codex-Bengalfox-Secondary-Used-Percent": {"100"},
+		}, wantCredential: true},
+	} {
+		for _, transport := range []string{"http", "sse-error", "sse-failed", "websocket"} {
+			t.Run(tc.name+"/"+transport, func(t *testing.T) {
+				var err error
+				switch transport {
+				case "http":
+					// Even a provider HTTP 400 containing usage_limit_reached remains 429.
+					err = newCodexStatusErrWithCooling(http.StatusBadRequest, []byte(body), tc.modelCooling, tc.headers)
+				case "sse-error", "sse-failed":
+					payload := `{"type":"error","error":` + quota + `}`
+					if transport == "sse-failed" {
+						payload = `{"type":"response.failed","response":{"error":` + quota + `}}`
+					}
+					terminal, _, ok := codexTerminalFailureErrWithCooling([]byte(payload), tc.modelCooling, tc.headers)
+					if !ok {
+						t.Fatal("terminal usage limit was not recognized")
+					}
+					err = terminal
+				case "websocket":
+					var ok bool
+					err, ok = parseCodexWebsocketErrorWithCooling([]byte(`{"type":"error","status":429,"error":`+quota+`}`), tc.modelCooling, tc.headers)
+					if !ok {
+						t.Fatal("websocket usage limit was not recognized")
+					}
+				}
+				var scoped interface{ IsCredentialScoped() bool }
+				if !errors.As(err, &scoped) || scoped.IsCredentialScoped() != tc.wantCredential {
+					t.Fatalf("credential scope = %v, want %t", err, tc.wantCredential)
+				}
+				var status interface{ StatusCode() int }
+				if !errors.As(err, &status) || status.StatusCode() != http.StatusTooManyRequests {
+					t.Fatalf("quota status was not preserved: %v", err)
+				}
+				var retry interface{ RetryAfter() *time.Duration }
+				if !errors.As(err, &retry) || retry.RetryAfter() == nil || *retry.RetryAfter() != time.Hour {
+					t.Fatalf("upstream reset was not preserved: %v", err)
+				}
+				if gjson.Get(err.Error(), "error.type").String() != "usage_limit_reached" {
+					t.Fatalf("upstream quota error was changed: %v", err)
+				}
+			})
+		}
+	}
+}
+
+func TestCodexQuotaScopeUsesLatestFrameHeaders(t *testing.T) {
+	const quota = `{"type":"usage_limit_reached","resets_in_seconds":3600}`
+	for _, tc := range []struct {
+		name           string
+		attempt        string
+		frame          string
+		wantCredential bool
+	}{
+		{name: "Spark frame overrides main handshake", attempt: "premium", frame: "codex_bengalfox"},
+		{name: "main frame overrides earlier Spark observation", attempt: "codex_bengalfox", frame: "premium", wantCredential: true},
+		{name: "frame without quota retains current attempt", attempt: "codex_bengalfox"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			payload := []byte(`{"type":"error","status":429,"headers":{"x-codex-active-limit":"` + tc.frame + `"},"error":` + quota + `}`)
+			err, ok := parseCodexWebsocketError(payload, http.Header{"X-Codex-Active-Limit": {tc.attempt}})
+			if !ok {
+				t.Fatal("websocket error not recognized")
+			}
+			var scoped interface{ IsCredentialScoped() bool }
+			if !errors.As(err, &scoped) || scoped.IsCredentialScoped() != tc.wantCredential {
+				t.Fatalf("latest observation did not control scope: %v", err)
+			}
+			terminal, _, ok := codexTerminalFailureErr(payload, http.Header{"X-Codex-Active-Limit": {tc.attempt}})
+			if !ok || terminal.IsCredentialScoped() != tc.wantCredential {
+				t.Fatalf("terminal event scope = %t, want %t", terminal.IsCredentialScoped(), tc.wantCredential)
+			}
+		})
+	}
+}
