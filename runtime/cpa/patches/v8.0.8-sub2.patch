@@ -0,0 +1,124 @@
+package handlers
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+)
+
+func TestSub2AccountPinOverridesSessionAffinity(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = httptest.NewRequest("POST", "/v1/responses", nil)
+	c.Request.Header.Set("X-Sub2API-CPA-Auth-ID", "chosen-identity")
+	ctx := context.WithValue(context.Background(), "gin", c)
+	ctx = WithPinnedAuthID(ctx, "stale-session-identity")
+	meta := requestExecutionMetadata(ctx)
+	if meta[coreexecutor.PinnedAuthMetadataKey] != "chosen-identity" {
+		t.Fatal("account pin was not enforced")
+	}
+}
+
+// Exercise the actual selection path, including retired Excel requests from
+// older clients, so the CPA upgrade cannot replace Sub2's selected identity.
+func TestSub2AccountPinKeepsNativeIdentityAndNeverFallsBack(t *testing.T) {
+	for _, streaming := range []bool{false, true} {
+		for _, state := range []string{"active", "disabled", "missing", "failed"} {
+			t.Run(fmt.Sprintf("stream=%t/%s", streaming, state), func(t *testing.T) {
+				model := "sub2-pin-" + t.Name()
+				chosen := "chosen-" + t.Name()
+				var calls []string
+				execute := func(auth *coreauth.Auth) error {
+					calls = append(calls, auth.ID)
+					if state == "failed" {
+						return errors.New("controlled upstream failure")
+					}
+					return nil
+				}
+				executor := &modelExecutionCaptureExecutor{
+					provider: "codex",
+					execute: func(_ context.Context, auth *coreauth.Auth, req coreexecutor.Request, _ coreexecutor.Options) (coreexecutor.Response, error) {
+						if req.Model != model {
+							t.Errorf("model changed to %s", req.Model)
+						}
+						return coreexecutor.Response{Payload: []byte(`{"status":"completed","output":[]}`)}, execute(auth)
+					},
+					stream: func(_ context.Context, auth *coreauth.Auth, req coreexecutor.Request, _ coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+						if req.Model != model {
+							t.Errorf("model changed to %s", req.Model)
+						}
+						if err := execute(auth); err != nil {
+							return nil, err
+						}
+						chunks := make(chan coreexecutor.StreamChunk, 1)
+						chunks <- coreexecutor.StreamChunk{Payload: []byte("data: " + `{"type":"response.completed","response":{"status":"completed","output":[]}}` + "\n\n")}
+						close(chunks)
+						return &coreexecutor.StreamResult{Chunks: chunks}, nil
+					},
+				}
+				manager := coreauth.NewManager(nil, nil, nil)
+				manager.SetRetryConfig(0, 0, 0)
+				manager.RegisterExecutor(executor)
+				auths := []*coreauth.Auth{
+					{ID: "other-" + t.Name(), Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"priority": "100"}},
+				}
+				if state != "missing" {
+					auths = append(auths, &coreauth.Auth{ID: chosen, Provider: "codex", Status: coreauth.StatusActive, Disabled: state == "disabled"})
+				}
+				for _, auth := range auths {
+					if _, err := manager.Register(context.Background(), auth); err != nil {
+						t.Fatal(err)
+					}
+					registry.GetGlobalRegistry().RegisterClient(auth.ID, auth.Provider, []*registry.ModelInfo{{ID: model}})
+					t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(auth.ID) })
+				}
+				handler := NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, manager)
+				c, _ := gin.CreateTestContext(httptest.NewRecorder())
+				c.Request = httptest.NewRequest("POST", "/v1/responses", nil)
+				c.Request.Header.Set("X-Sub2API-CPA-Auth-ID", chosen)
+				c.Request.Header.Set("X-Sub2API-BasisPoints", "1")
+				ctx := WithPinnedAuthID(context.WithValue(context.Background(), "gin", c), auths[0].ID)
+				body := []byte(fmt.Sprintf(`{"model":%q,"input":"benign fixture"}`, model))
+				failed := false
+				if streaming {
+					chunks, _, errs := handler.ExecuteStreamWithAuthManager(ctx, "openai-response", model, body, "")
+					if chunks != nil {
+						for range chunks {
+						}
+					}
+					if errs != nil {
+						for err := range errs {
+							if err != nil {
+								failed = true
+							}
+						}
+					}
+				} else {
+					_, _, err := handler.ExecuteWithAuthManager(ctx, "openai-response", model, body, "")
+					failed = err != nil
+				}
+				if failed != (state != "active") {
+					t.Fatalf("failure=%t for state %s", failed, state)
+				}
+				for _, id := range calls {
+					if id != chosen {
+						t.Fatalf("selected %s instead of %s", id, chosen)
+					}
+				}
+				if state == "active" && len(calls) != 1 {
+					t.Fatalf("calls=%v", calls)
+				}
+				if (state == "disabled" || state == "missing") && len(calls) != 0 {
+					t.Fatalf("inactive identity made calls: %v", calls)
+				}
+			})
+		}
+	}
+}
