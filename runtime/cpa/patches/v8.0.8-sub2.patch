+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+// Exercise actual upstream decoding and scheduler decisions together. The same
+// exhausted Spark metadata accompanies both Spark and premium responses, so its
+// mere presence must not turn a premium quota failure into a model-only failure.
+func TestCodexSparkQuotaScopePreservesOtherModels(t *testing.T) {
+	const sparkModel = "gpt-5.3-codex-spark"
+	const astraModel = "gpt-6-astra"
+	const lunaModel = "gpt-5.6-luna"
+	const apiKey = "spark-scope-test-key"
+	const created = `{"type":"response.created","response":{"id":"spark-scope-created"}}`
+	const quota = `{"type":"usage_limit_reached","message":"You've hit your usage limit.","resets_in_seconds":3600}`
+	const completed = `{"type":"response.completed","response":{"id":"spark-scope-success","status":"completed","output":[{"id":"spark-scope-message","type":"message","role":"assistant","status":"completed","content":[{"type":"output_text","text":"OK","annotations":[]}]}],"usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}}`
+
+	for _, transport := range []string{
+		"http-429", "sse-error", "sse-failed", "websocket-handshake",
+		"websocket-error", "websocket-quota-error", "websocket-quota-failed",
+	} {
+		for _, mode := range []string{"execute", "stream", "stream-buffered"} {
+			for _, activeLimit := range []string{"codex_bengalfox", "premium"} {
+				t.Run(transport+"/"+mode+"/"+activeLimit, func(t *testing.T) {
+					credentialScoped := activeLimit == "premium"
+					websocketTransport := strings.HasPrefix(transport, "websocket-")
+					type attempt struct {
+						model string
+						key   string
+					}
+					var attemptsMu sync.Mutex
+					var attempts []attempt
+					recordAttempt := func(model, key string) int {
+						attemptsMu.Lock()
+						defer attemptsMu.Unlock()
+						attempts = append(attempts, attempt{model: model, key: key})
+						return len(attempts)
+					}
+					attemptCount := func() int {
+						attemptsMu.Lock()
+						defer attemptsMu.Unlock()
+						return len(attempts)
+					}
+					quotaHeaders := func(active string) http.Header {
+						mainUsed := "95"
+						if credentialScoped {
+							mainUsed = "100"
+						}
+						return http.Header{
+							"X-Codex-Active-Limit":                          []string{active},
+							"X-Codex-Primary-Used-Percent":                  []string{mainUsed},
+							"X-Codex-Primary-Window-Minutes":                []string{"10080"},
+							"X-Codex-Primary-Reset-After-Seconds":           []string{"7200"},
+							"X-Codex-Bengalfox-Limit-Name":                  []string{"GPT-5.3-Codex-Spark"},
+							"X-Codex-Bengalfox-Primary-Used-Percent":        []string{"100"},
+							"X-Codex-Bengalfox-Primary-Window-Minutes":      []string{"10080"},
+							"X-Codex-Bengalfox-Primary-Reset-After-Seconds": []string{"3600"},
+						}
+					}
+					errorFrame := func(withHeaders bool) string {
+						frame := map[string]any{
+							"type": "error", "status": http.StatusTooManyRequests,
+							"body": map[string]any{"error": json.RawMessage(quota)},
+						}
+						if withHeaders {
+							headers := make(map[string]string)
+							for key, values := range quotaHeaders(activeLimit) {
+								headers[key] = values[0]
+							}
+							frame["headers"] = headers
+						}
+						encoded, errMarshal := json.Marshal(frame)
+						if errMarshal != nil {
+							t.Fatalf("marshal websocket error: %v", errMarshal)
+						}
+						return string(encoded)
+					}
+					wsErrorWithHeaders, wsErrorWithoutHeaders := errorFrame(true), errorFrame(false)
+					mainUsed := 95
+					if credentialScoped {
+						mainUsed = 100
+					}
+					quotaEvent := fmt.Sprintf(`{"type":"codex.rate_limits","metered_limit_name":%q,"rate_limits":{"allowed":%t,"limit_reached":%t,"primary":{"used_percent":%d,"window_minutes":10080,"reset_after_seconds":7200}},"additional_rate_limits":{"GPT-5.3-Codex-Spark":{"allowed":false,"limit_reached":true,"primary":{"used_percent":100,"window_minutes":10080,"reset_after_seconds":3600}}}}`, activeLimit, !credentialScoped, credentialScoped, mainUsed)
+					upgrader := websocket.Upgrader{}
+					server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+						key := strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer ")
+						// A rejected upgrade has no request frame yet. The first
+						// request below always asks for Spark.
+						if transport == "websocket-handshake" && attemptCount() == 0 {
+							recordAttempt(sparkModel, key)
+							for name, values := range quotaHeaders(activeLimit) {
+								w.Header()[name] = values
+							}
+							w.Header().Set("Content-Type", "application/json")
+							w.WriteHeader(http.StatusTooManyRequests)
+							_, _ = fmt.Fprintf(w, `{"error":%s}`, quota)
+							return
+						}
+						if websocketTransport {
+							conn, errUpgrade := upgrader.Upgrade(w, r, nil)
+							if errUpgrade != nil {
+								t.Errorf("upgrade websocket: %v", errUpgrade)
+								return
+							}
+							defer conn.Close()
+							_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+							_, request, errRead := conn.ReadMessage()
+							if errRead != nil {
+								t.Errorf("read websocket request: %v", errRead)
+								return
+							}
+							model := gjson.GetBytes(request, "model").String()
+							recordAttempt(model, key)
+							events := []string{created, completed}
+							if model == sparkModel {
+								switch transport {
+								case "websocket-error":
+									events = []string{created, wsErrorWithHeaders}
+								case "websocket-quota-error":
+									events = []string{quotaEvent, created, wsErrorWithoutHeaders}
+								case "websocket-quota-failed":
+									events = []string{quotaEvent, created, `{"type":"response.failed","response":{"error":` + quota + `}}`}
+								default:
+									t.Errorf("Spark was retried after the rejected websocket handshake")
+									return
+								}
+							}
+							for _, event := range events {
+								if errWrite := conn.WriteMessage(websocket.TextMessage, []byte(event)); errWrite != nil {
+									t.Errorf("write websocket event: %v", errWrite)
+									return
+								}
+							}
+							return
+						}
+						request, errRead := io.ReadAll(r.Body)
+						if errRead != nil {
+							t.Errorf("read HTTP request: %v", errRead)
+							return
+						}
+						model := gjson.GetBytes(request, "model").String()
+						recordAttempt(model, key)
+						active := "premium"
+						if model == sparkModel {
+							active = activeLimit
+						}
+						for name, values := range quotaHeaders(active) {
+							w.Header()[name] = values
+						}
+						if model == sparkModel && transport == "http-429" {
+							w.Header().Set("Content-Type", "application/json")
+							w.WriteHeader(http.StatusTooManyRequests)
+							_, _ = fmt.Fprintf(w, `{"error":%s}`, quota)
+							return
+						}
+						terminal := completed
+						if model == sparkModel {
+							terminal = `{"type":"error","error":` + quota + `}`
+							if transport == "sse-failed" {
+								terminal = `{"type":"response.failed","response":{"error":` + quota + `}}`
+							}
+						}
+						w.Header().Set("Content-Type", "text/event-stream")
+						if _, errWrite := fmt.Fprintf(w, "data: %s\n\ndata: %s\n\n", created, terminal); errWrite != nil {
+							t.Errorf("write SSE response: %v", errWrite)
+						}
+					}))
+					defer server.Close()
+
+					manager := cliproxyauth.NewManager(nil, &cliproxyauth.RoundRobinSelector{}, nil)
+					manager.SetRetryConfig(0, 0, 0)
+					cfg := &config.Config{}
+					cfg.Codex.StreamBootstrapBuffering = mode == "stream-buffered"
+					if websocketTransport {
+						manager.RegisterExecutor(runtimeexecutor.NewCodexWebsocketsExecutor(cfg))
+					} else {
+						manager.RegisterExecutor(runtimeexecutor.NewCodexExecutor(cfg))
+					}
+					authID := "spark-scope-" + t.Name()
+					registry.GetGlobalRegistry().RegisterClient(authID, "codex", []*registry.ModelInfo{{ID: sparkModel}, {ID: astraModel}, {ID: lunaModel}})
+					t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(authID) })
+					if _, errRegister := manager.Register(context.Background(), &cliproxyauth.Auth{
+						ID: authID, Provider: "codex", Status: cliproxyauth.StatusActive,
+						Attributes: map[string]string{"base_url": server.URL, "api_key": apiKey},
+						Metadata:   map[string]any{"disable_cooling": false},
+					}); errRegister != nil {
+						t.Fatal(errRegister)
+					}
+					run := func(model string) ([]byte, error) {
+						t.Helper()
+						ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+						defer cancel()
+						request := cliproxyexecutor.Request{Model: model, Payload: []byte(fmt.Sprintf(`{"model":%q,"input":"hello"}`, model))}
+						options := cliproxyexecutor.Options{Stream: mode != "execute", SourceFormat: sdktranslator.FromString("openai-response")}
+						if mode == "execute" {
+							response, errExecute := manager.Execute(ctx, []string{"codex"}, request, options)
+							return response.Payload, errExecute
+						}
+						result, errStream := manager.ExecuteStream(ctx, []string{"codex"}, request, options)
+						if errStream != nil {
+							return nil, errStream
+						}
+						var payload []byte
+						var terminalErr error
+						for chunk := range result.Chunks {
+							payload = append(payload, chunk.Payload...)
+							if chunk.Err != nil {
+								terminalErr = chunk.Err
+							}
+						}
+						return payload, terminalErr
+					}
+
+					before := time.Now()
+					_, quotaErr := run(sparkModel)
+					if quotaErr == nil || !strings.Contains(quotaErr.Error(), "usage_limit_reached") {
+						t.Fatalf("expected the original Spark quota error, got %v", quotaErr)
+					}
+					var status interface{ StatusCode() int }
+					if !errors.As(quotaErr, &status) || status.StatusCode() != http.StatusTooManyRequests {
+						t.Errorf("quota error lost HTTP 429: %T %v", quotaErr, quotaErr)
+					}
+					var scoped interface{ IsCredentialScoped() bool }
+					if !errors.As(quotaErr, &scoped) || scoped.IsCredentialScoped() != credentialScoped {
+						t.Errorf("credential scope = %v, want %t; error=%T %v", scoped, credentialScoped, quotaErr, quotaErr)
+					}
+					var retry interface{ RetryAfter() *time.Duration }
+					if !errors.As(quotaErr, &retry) || retry.RetryAfter() == nil || *retry.RetryAfter() != time.Hour {
+						t.Errorf("quota error lost its one-hour upstream reset: %T %v", quotaErr, quotaErr)
+					}
+					auth, ok := manager.GetByID(authID)
+					if !ok {
+						t.Fatal("test credential disappeared")
+					}
+					state := auth.ModelStates[sparkModel]
+					if state == nil || !state.Quota.Exceeded || state.NextRetryAfter.Before(before.Add(time.Hour)) || state.Quota.NextRecoverAt.Before(before.Add(time.Hour)) {
+						t.Fatalf("Spark cooldown lost the upstream reset: %+v", state)
+					}
+					sparkDeadline, sparkQuotaDeadline := state.NextRetryAfter, state.Quota.NextRecoverAt
+					if credentialScoped {
+						if auth.Quota.Reason != "credential_quota" || auth.Quota.NextRecoverAt.Before(before.Add(time.Hour)) {
+							t.Errorf("premium control lost its account-wide cooldown: %+v", auth.Quota)
+						}
+					} else if auth.Quota.Reason == "credential_quota" {
+						t.Errorf("independent Spark quota cooled the whole credential: %+v", auth.Quota)
+					}
+					for _, model := range []string{astraModel, lunaModel} {
+						payload, errOther := run(model)
+						if credentialScoped {
+							if errOther == nil {
+								t.Errorf("premium account-wide quota unexpectedly allowed %s: %s", model, payload)
+							}
+						} else if errOther != nil || !strings.Contains(string(payload), `"completed"`) || !strings.Contains(string(payload), "OK") {
+							t.Errorf("%s must still complete using the same credential: payload=%s error=%v", model, payload, errOther)
+						}
+					}
+					auth, _ = manager.GetByID(authID)
+					state = auth.ModelStates[sparkModel]
+					if state == nil || !state.Quota.Exceeded || !state.NextRetryAfter.Equal(sparkDeadline) || !state.Quota.NextRecoverAt.Equal(sparkQuotaDeadline) {
+						t.Errorf("other models' results changed Spark's live cooldown: %+v", state)
+					}
+					if _, errSparkRetry := run(sparkModel); errSparkRetry == nil {
+						t.Error("Spark became selectable before its quota reset")
+					}
+					wantModels := []string{sparkModel}
+					if !credentialScoped {
+						wantModels = append(wantModels, astraModel, lunaModel)
+					}
+					attemptsMu.Lock()
+					gotAttempts := append([]attempt(nil), attempts...)
+					attemptsMu.Unlock()
+					if len(gotAttempts) != len(wantModels) {
+						t.Fatalf("upstream attempts = %+v, want models %v on one credential", gotAttempts, wantModels)
+					}
+					for i, got := range gotAttempts {
+						if got.model != wantModels[i] || got.key != apiKey {
