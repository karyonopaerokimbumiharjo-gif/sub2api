index 0000000..e2966f5
--- /dev/null
+++ b/internal/runtime/executor/helps/codex_quota_scope.go
@@ -0,0 +1,27 @@
+package helps
+
+import (
+	"net/http"
+	"strings"
+)
+
+// CodexHasIndependentSparkLimit reports whether the current upstream attempt
+// explicitly selected Spark's separate quota pool. Other quota windows may be
+// included in every response, so only the active limit can narrow error scope.
+// Later observations (for example websocket error headers) override earlier ones.
+// Unknown or absent limits retain the existing credential-wide quota behavior.
+func CodexHasIndependentSparkLimit(observations ...http.Header) bool {
+	for i := len(observations) - 1; i >= 0; i-- {
+		active := strings.TrimSpace(observations[i].Get("X-Codex-Active-Limit"))
+		if active == "" {
+			continue
+		}
+		switch strings.ToLower(active) {
+		case "codex_bengalfox", "gpt-5.3-codex-spark":
+			return true
+		default:
+			return false
+		}
+	}
+	return false
+}
